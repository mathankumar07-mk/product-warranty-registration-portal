APP_NAME=Product Warranty Registration Portal
DATABASE_URL=postgresql+psycopg2://warranty_app:changeme@localhost:5432/warranty_portal
SECRET_KEY=replace-with-a-long-random-local-secret
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
SESSION_COOKIE=warranty_session
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false

# Alternatively, leave DATABASE_URL unset and configure the parts below.
